# =============================================================================
# EduCash — Variáveis de Ambiente (Exemplo)
# =============================================================================
# Copie este arquivo para `frontend/.env` (ou `.env` na pasta frontend)
# e preencha com os valores públicos do seu projeto Supabase.
#
# IMPORTANTE (Segurança):
# - NUNCA faça commit de arquivos `.env` reais no controle de versão.
# - Utilize APENAS a chave pública (Publishable Key / Anon Key) no frontend.
# - NUNCA exponha a chave administrativa (`service_role` / Secret Key) no frontend.
# =============================================================================

# URL pública do projeto Supabase (Ex.: https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Chave pública / anônima do cliente Supabase (Publishable Key / Anon Public Key)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

