# =============================================================================
# EduCash Frontend — Variáveis de Ambiente (Exemplo)
# =============================================================================
# Copie este arquivo para `.env` dentro do diretório `frontend/`
# e preencha com os valores públicos do seu projeto Supabase.
#
# IMPORTANTE (Segurança):
# - NUNCA faça commit do arquivo `.env` com credenciais reais.
# - Utilize APENAS a chave pública (Publishable Key / Anon Key) no cliente React.
# - NUNCA exponha a chave `service_role` (Secret Key) no frontend.
# =============================================================================

# URL pública do projeto Supabase (Ex.: https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Chave pública / anônima do cliente Supabase (Publishable Key / Anon Public Key)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

